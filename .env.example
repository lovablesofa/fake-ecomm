# Public URL of the app, used in email links.
APP_URL=http://localhost:3000

# libSQL / SQLite. Local file by default; use a Turso URL + token in production.
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Resend. Without a key, emails are logged to /dev/outbox instead of being sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Cartharsis <orders@yourdomain.com>"

# Tracking speed multiplier. 1 = realistic (days). 60 = hours become minutes (good for demos).
TRACKING_SPEED=60

# In-process scheduler for tracking emails. Default: on in dev, off in production.
# INTERNAL_SCHEDULER=on

# Protects /api/cron/advance for external schedulers.
# CRON_SECRET=

# Catalog pipeline (pnpm catalog:generate / catalog:build). Only needed locally.
# OPENROUTER_API_KEY=sk-or-...
